---
import BaseLayout from "../layouts/BaseLayout.astro";
import EstimateSection from "../components/EstimateSection.astro";
import { site } from "../data/site";
import { services } from "../data/services";
import { featuredPhotos } from "../data/gallery";
---

<BaseLayout
  title={site.name}
  description="Kitchen, bath, basement and whole-home remodeling in Central New York, plus roofing, siding and windows. One crew from demo to final finish."
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{site.tagline}</p>
        <h1 class="display h1">Kitchens, baths and whole-home remodels, done right.</h1>
        <p class="lead">
          {site.name} renovates homes across {site.area}. One crew handles the whole project, from demo to final
          finish, including the roofing and siding that often come with it.
        </p>
        <div class="hero-ctas">
          <a class="btn btn--yellow" href="/contact/">Request a free estimate</a>
          <a class="btn btn--outline" href="/projects/">See our work</a>
        </div>
      </div>
      <div class="hero-photo">
        <div class="badge" aria-hidden="true"><img src="/brand/phoenix-mark-white.svg" alt="" /></div>
        <img src="/images/exterior.webp" alt="Two-story brick home with renovated double porches" width="1024" height="720" fetchpriority="high" />
      </div>
    </div>
  </section>

  <div class="divider" aria-hidden="true"></div>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 class="display h2">What we do</h2>
          <p class="lead">From kitchens and baths to decks and roofs, we help you plan the design and our own crew builds it.</p>
        </div>
        <a href="/services/">All services</a>
      </div>
      <div class="scroll-row">
        {services.map((s) => (
          <a class="card" href={`/services/${s.slug}/`}>
            <img src={s.image} alt={s.imageAlt} loading="lazy" />
            <div class="card-body">
              <h3>{s.name}</h3>
              <p>{s.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--warm">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display h2">Recent renovations</h2>
        <a href="/projects/">See more</a>
      </div>
      <div class="scroll-row scroll-row--photos">
        {featuredPhotos.map((ph) => (
          <div><img src={ph.src} alt={ph.alt} loading="lazy" /></div>
        ))}
      </div>
    </div>
  </section>

  <section class="owners">
    <div class="wrap owners-inner">
      <div>
        <h2>Investors and property owners</h2>
        <p>Everything we do for homeowners, we do for investors, with your goals for the property in mind.</p>
      </div>
      <a class="btn btn--outline" href="/investors/">Work with us</a>
    </div>
  </section>

  <EstimateSection />
</BaseLayout>

<style>
  .hero { background: var(--ink); color: #fff; }
  .hero-inner { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; padding-block: 56px 72px; }
  .hero-copy { flex: 1 1 460px; min-width: 0; }
  .hero-copy .h1 { margin-bottom: 24px; }
  .hero-copy .lead { font-size: 20px; color: var(--muted-on-dark); margin: 0 0 32px; }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-photo { flex: 1 1 480px; min-width: 0; position: relative; }
  .hero-photo > img { width: 100%; height: 460px; object-fit: cover; border-radius: 6px; }
  .badge {
    position: absolute; left: -28px; bottom: -28px; width: 132px; height: 132px; border-radius: 50%;
    background: var(--ink); border: 3px solid var(--yellow); display: flex; align-items: center; justify-content: center;
  }
  .badge img { width: 96px; height: auto; }
  .section-head .lead { margin: 12px 0 0; }
  .owners { background: var(--ink-raised); color: #fff; }
  .owners-inner { display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: center; justify-content: space-between; padding-block: 48px; }
  .owners h2 { margin: 0 0 6px; font-size: 24px; font-weight: 600; }
  .owners p { margin: 0; color: var(--muted-on-dark); }
  @media (max-width: 700px) {
    .hero-inner { padding-block: 40px 56px; }
    .hero-copy .lead { font-size: 18px; }
    .hero-photo > img { height: 280px; }
    .badge { left: -8px; bottom: -20px; width: 96px; height: 96px; }
    .badge img { width: 68px; }
  }
</style>
