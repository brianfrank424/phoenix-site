---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page could not be found.">
  <section class="page-hero">
    <div class="wrap">
      <h1 class="display h1">Page not found</h1>
      <p class="lead">That page has moved or does not exist.</p>
      <p style="margin-top:24px"><a class="btn btn--yellow" href="/">Back to the home page</a></p>
    </div>
  </section>
</BaseLayout>
