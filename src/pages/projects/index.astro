---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EstimateSection from "../../components/EstimateSection.astro";
import { gallery } from "../../data/gallery";
import { services } from "../../data/services";
import { site } from "../../data/site";

const serviceName = (slug: string) => services.find((s) => s.slug === slug)?.name ?? "";
// Only offer filters for services that have photos.
const filters = services
  .map((s) => ({ slug: s.slug, name: s.name, count: gallery.filter((p) => p.service === s.slug).length }))
  .filter((f) => f.count > 0);
---

<BaseLayout title="Our work" description={`Remodeling and renovation work by ${site.name} across ${site.area}.`}>
  <section class="page-hero">
    <div class="wrap">
      <h1 class="display h1">Our work</h1>
      <p class="lead">A look at recent remodeling and renovation work across {site.area}.</p>
    </div>
  </section>
  <div class="divider" aria-hidden="true"></div>
  <section class="section">
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filter photos by type of work">
        <button type="button" data-filter="all" aria-pressed="true">All <span>{gallery.length}</span></button>
        {filters.map((f) => (
          <button type="button" data-filter={f.slug} aria-pressed="false">{f.name} <span>{f.count}</span></button>
        ))}
      </div>
      <p id="filter-status" class="visually-hidden" aria-live="polite"></p>
      <div class="gallery">
        {gallery.map((ph) => (
          <figure data-service={ph.service ?? ""}>
            <img src={ph.src} alt={ph.alt} loading="lazy" />
            {ph.service && <figcaption><a href={`/services/${ph.service}/`}>{serviceName(ph.service)}</a></figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
  <EstimateSection />
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".filters button"));
  const items = Array.from(document.querySelectorAll<HTMLElement>(".gallery figure"));
  const status = document.getElementById("filter-status");

  function apply(filter: string, updateUrl = true) {
    if (!buttons.some((b) => b.dataset.filter === filter)) filter = "all";
    let shown = 0;
    for (const item of items) {
      const match = filter === "all" || item.dataset.service === filter;
      item.hidden = !match;
      if (match) shown++;
    }
    for (const b of buttons) b.setAttribute("aria-pressed", String(b.dataset.filter === filter));
    if (status) status.textContent = `Showing ${shown} photos`;
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (filter === "all") url.searchParams.delete("service");
      else url.searchParams.set("service", filter);
      history.replaceState(null, "", url);
    }
  }

  for (const b of buttons) b.addEventListener("click", () => apply(b.dataset.filter ?? "all"));
  const initial = new URLSearchParams(window.location.search).get("service");
  if (initial) {
    apply(initial, false);
    buttons.find((b) => b.getAttribute("aria-pressed") === "true")?.scrollIntoView({ block: "nearest", inline: "center" });
  }
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 32px; }
  .filters button {
    font: inherit; font-weight: 600; font-size: 16px; cursor: pointer;
    min-height: 44px; padding: 10px 18px; border-radius: 999px;
    border: 1.5px solid var(--ink); background: #fff; color: var(--ink);
  }
  .filters button span { font-weight: 500; color: var(--muted); margin-left: 4px; }
  @media (hover: hover) { .filters button:hover { background: var(--paper-warm); } }
  .filters button[aria-pressed="true"] { background: var(--ink); color: #fff; }
  .filters button[aria-pressed="true"] span { color: var(--yellow); }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; }
  figure { margin: 0; }
  figure[hidden] { display: none; }
  figure img { width: 100%; height: 300px; object-fit: cover; border-radius: 6px; }
  figcaption { margin-top: 10px; font-weight: 600; }
  figcaption a { color: var(--ink); text-decoration: none; }
  figcaption a:hover { color: var(--link); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 700px) {
    .filters { flex-wrap: nowrap; overflow-x: auto; margin-inline: calc(var(--gutter) * -1); padding: 0 var(--gutter) 8px; }
    .filters button { flex: 0 0 auto; }
    .gallery { grid-template-columns: 1fr; }
    figure img { height: 260px; }
  }
</style>
