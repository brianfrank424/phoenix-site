---
import BaseLayout from "../layouts/BaseLayout.astro";
import EstimateSection from "../components/EstimateSection.astro";
import { site } from "../data/site";
---

<BaseLayout title="Request an estimate" description={`Request a free estimate from ${site.name}. Call ${site.phone} or send a few details about your project.`}>
  <section class="page-hero">
    <div class="wrap">
      <h1 class="display h1">Request an estimate</h1>
      <p class="lead">Tell us a little about the project. We will call to set up a visit.</p>
    </div>
  </section>
  <EstimateSection heading="Tell us about your project" />
</BaseLayout>
