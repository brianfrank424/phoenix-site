---
import { site, townList } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap inner">
    <div class="brand">
      <img src="/brand/logo-horizontal-white.png" alt={site.name} width="674" height="162" loading="lazy" />
      <p>© {year} {site.legalName} · Serving {site.area}</p>
      <p>{townList}</p>
    </div>
    <nav class="links" aria-label="Footer">
      <a href="/services/">Services</a>
      <a href="/projects/">Projects</a>
      <a href="/about/">About</a>
      <a href="/faq/">FAQ</a>
      <a href="/investors/">Investors</a>
      <a href="/contact/">Request an estimate</a>
      <a href="/privacy/">Privacy policy</a>
    </nav>
    <div class="contact">
      <a href={site.phoneHref}>{site.phone}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink-deep); color: var(--quiet-on-dark); font-size: 15px; }
  .inner { display: flex; flex-wrap: wrap; gap: 24px 48px; justify-content: space-between; padding-block: 40px; }
  .brand img { height: 52px; width: auto; margin-bottom: 12px; }
  .brand p { margin: 0 0 4px; }
  .links { display: grid; grid-template-columns: repeat(2, auto); gap: 8px 32px; align-content: start; }
  .links a, .contact a { color: var(--quiet-on-dark); text-decoration: none; }
  .links a:hover, .contact a:hover { color: var(--yellow); }
  .contact { display: flex; flex-direction: column; gap: 8px; }
  .contact a:first-child { color: #fff; font-weight: 600; font-size: 18px; }
</style>
